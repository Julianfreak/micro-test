{
    "swagger": "2.0",
    "info": {
        "description": "Servicio de salud para la infraestructura de microservicios robustos en Go.",
        "title": "Micro-Test API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Soporte Técnico",
            "url": "http://www.swagger.io/support",
            "email": "support@swagger.io"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8089",
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Obtiene el estado actual y el agente del microservicio",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Verificar el estado del servicio",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.HealthResponse": {
            "type": "object",
            "properties": {
                "agent": {
                    "type": "string",
                    "example": "local"
                },
                "status": {
                    "type": "string",
                    "example": "UP"
                }
            }
        }
    }
}